# Copie para deploy/.env na VPS. Nunca faça commit do deploy/.env.
# Endereço público (precisa apontar para o IP da VPS).
DOMAIN=studysite.exemplo.com.br
# Senha forte do PostgreSQL de produção, ex.: openssl rand -base64 32
DB_PASSWORD=
# Deixe "true" só até o time criar as contas; depois "false" e: docker compose up -d
REGISTRATION_ENABLED=true
# Rede, entrypoint e certresolver do Traefik que já roda na máquina.
TRAEFIK_NETWORK=fiscview_net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
